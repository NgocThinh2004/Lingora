# Copy this file to .env on the Ubuntu server and replace every placeholder.
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=https://your-domain.example

MYSQL_ROOT_PASSWORD=replace_with_a_long_random_root_password
DB_HOST=mysql
DB_PORT=3306
DB_NAME=lingora_db
DB_TEST_NAME=lingora_test
DB_USER=lingora_app
DB_PASSWORD=replace_with_a_long_random_app_password
DB_LOGGING=false

REDIS_HOST=redis
REDIS_PORT=6379

JWT_ACCESS_SECRET=replace_with_a_long_random_value
JWT_REFRESH_SECRET=replace_with_another_long_random_value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=12

RESET_OTP_TTL_MINUTES=5
RESET_OTP_RESEND_SECONDS=60
RESET_OTP_MAX_ATTEMPTS=5

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_me
SMTP_PASSWORD=replace_me
MAIL_FROM=Lingora <no-reply@example.com>

R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lingora-media
R2_PUBLIC_BASE_URL=https://pub-YOUR_BUCKET_ID.r2.dev

TEMP_MEDIA_TTL_HOURS=24
TEMP_MEDIA_CLEANUP_INTERVAL_MINUTES=60

TRANSLATION_PROVIDER_ORDER=deepl,azure,google-cloud,google-free
TRANSLATION_WORKER_ENABLED=true
TRANSLATION_WORKER_INTERVAL_MS=5000
TRANSLATION_JOB_STALE_MS=300000
TRANSLATION_PROVIDER_TIMEOUT_MS=15000
TRANSLATION_CHUNK_SIZE=2500
TRANSLATION_BATCH_CHAR_LIMIT=10000
TRANSLATION_BATCH_SEGMENT_LIMIT=50

DEEPL_API_URL=https://api-free.deepl.com/v2/translate
DEEPL_API_KEY=
GOOGLE_CLOUD_TRANSLATION_URL=https://translation.googleapis.com/language/translate/v2
GOOGLE_CLOUD_TRANSLATION_API_KEY=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
GOOGLE_FREE_ENABLED=true
GOOGLE_FREE_MAX_TEXT_LENGTH=3000
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
