NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:4200

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lingora_dev
DB_TEST_NAME=lingora_test
DB_USER=lingora_app
DB_PASSWORD=replace_me
DB_LOGGING=false

JWT_ACCESS_SECRET=replace_with_a_long_random_value
JWT_REFRESH_SECRET=replace_with_another_long_random_value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=12

RESET_TOKEN_TTL_MINUTES=30
RESET_PASSWORD_URL=http://localhost:4200/reset-password

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_me
SMTP_PASSWORD=replace_me
MAIL_FROM=Lingora <no-reply@example.com>

UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=5

TRANSLATION_PROVIDER=mock
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
TRANSLATION_WORKER_INTERVAL_MS=5000
